#!/usr/bin/env bash
# ADF-COVERS(implementation): REQ-122-008, REQ-122-015
# pre-commit — 決定論的ローカル検証ゲート（DEC-066 決定1、ACT-DESIGN-002「pre-commit」実行契約）。
# シェル本体は薄いラッパー。実処理は検証エンジン（bun 実行）と正規投影スクリプトへ委譲する。
# REPO_ROOT は git rev-parse --show-toplevel 起点（worktree 環境対応）。
# 失敗時は非ゼロ終了でコミットを物理ブロックし、--no-verify 緊急バイパスを案内する。
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# 検証エンジンの配置解決: source 側ツリー（SoT パス）を第一候補とし、
# .opencode/ 投影先へフォールバックする（worktree では .opencode/skills/ の
# agentdev-* junction が未再作成のため、worktree-operations.md「SoT パス起点実行」に従う）。
if [ -f "$REPO_ROOT/src/common/skills/repo-agentdev-integrity/scripts/cli.ts" ]; then
  INTEGRITY_DIR="$REPO_ROOT/src/common/skills/repo-agentdev-integrity/scripts"
else
  INTEGRITY_DIR="$REPO_ROOT/.opencode/skills/repo-agentdev-integrity/scripts"
fi
CLI="$INTEGRITY_DIR/cli.ts"
AUTOGEN_GATE="$INTEGRITY_DIR/check_autogen_freshness.ts"
SELF_SYNC="$REPO_ROOT/scripts/self-sync.ps1"
GATE="$REPO_ROOT/scripts/git-hooks/minimal-gate.mjs"

# --- Step 0（Minimal-by-Default ゲート: 物理バジェット・堆積語彙） ---
echo "[pre-commit] Minimal-by-Default ゲート（minimal-gate.mjs）を実行します。"
if ! bun "$GATE" pre-commit; then
  echo "[pre-commit] Minimal-by-Default ゲートが失敗したため、このコミットを物理ブロックしました。" >&2
  exit 1
fi

fail_with_guidance() {
  echo "" >&2
  echo "[pre-commit] 検証ゲートが失敗したため、このコミットを物理ブロックしました。" >&2
  echo "  対応方法:" >&2
  echo "  - 投影忘れ（IR-016）: scripts/self-sync.ps1 -Mode apply で .opencode/ を再投影する（本 hook は自動実行済み。自動実行後も不合格の場合は投影結果と src/ 正本の内容差を確認する）" >&2
  echo "  - 整合性違反: bun run \"$CLI\" --root \"$REPO_ROOT\" --changed で違反内容を確認して修正する" >&2
  echo "  - AUTOGEN 鮮度: bun run \"$AUTOGEN_GATE\" --root \"$REPO_ROOT\" で再生成対象を確認する（生成は bun run \"$INTEGRITY_DIR/generate_indexes.ts\" --root \"$REPO_ROOT\"）" >&2
  echo "  緊急時（ロールバック等）のバイパス: git commit --no-verify" >&2
  exit 1
}

run_projection() {
  # 正規投影手段は scripts/self-sync.ps1 -Mode apply（REQ-050-003）。
  # 対話ウィザードは -Mode 指定時に起動しない（REQ-009-040）。
  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$SELF_SYNC" -Mode apply
  elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File "$SELF_SYNC" -Mode apply
  else
    echo "[pre-commit] PowerShell (pwsh / powershell) が見つからないため、src/ の投影を実行できません。" >&2
    echo "  scripts/self-sync.ps1 -Mode apply を実行できる環境で再コミットするか、--no-verify でバイパスしてください。" >&2
    return 1
  fi
}

# git status --porcelain -z（NUL 区切り、quote なし）からパス列を抽出する。
# 通常レコードは「XY path」（XY は2文字の状態欄、3文字目は空白）。
# rename 元パスのレコードは状態欄を持たないため、状態欄の字型で除外する。
porcelain_paths_from_git() {
  local re='^[MARTCDU?! ]{2} (.+)$'
  while IFS= read -r -d '' rec; do
    if [[ "$rec" =~ $re ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done
}

staged_paths() {
  git diff --cached --name-only -z | while IFS= read -r -d '' f; do
    printf '%s\n' "$f"
  done
}

# --- Step 1（src/ → .opencode/ 自動投影・同期）---
# git diff --cached --name-only に src/ 配下のファイルが含まれる場合のみ投影を実行し、
# 投影で新たに差分が生じた .opencode/ 配下のパス（自変更＝投影分）のみを git add で
# ステージングへ追加する。投影前に既に作業 tree に存在した変更は対象に含めない。
stages_src=false
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    src/*) stages_src=true; break ;;
  esac
done < <(staged_paths)

if [ "$stages_src" = true ]; then
  echo "[pre-commit] src/ のステージングを検出しました。投影（scripts/self-sync.ps1 -Mode apply）を実行します。"
  before_paths="$({ git status --porcelain -z -- .opencode/ || true; } | porcelain_paths_from_git | sort -u)"
  if ! run_projection; then
    fail_with_guidance
  fi
  after_paths="$({ git status --porcelain -z -- .opencode/ || true; } | porcelain_paths_from_git | sort -u)"

  # 集合差 after_paths \ before_paths ＝ 投影によって新たに差分が生じたパス。
  newly_changed="$(comm -13 <(printf '%s\n' "$before_paths") <(printf '%s\n' "$after_paths") || true)"

  if [ -n "$newly_changed" ]; then
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      git add -- "$p"
      echo "[pre-commit] 投影出力をステージングへ追加しました: $p"
    done <<<"$newly_changed"
  else
    echo "[pre-commit] 投影による新規差分はありません。"
  fi
fi

# --- Step 2（差分整合性チェック）---
# cli.ts --changed: ステージングされたファイル（git diff --cached）に関連する IR ルールのみ高速検証。
# --root は検査対象リポジトリルートの明示指定（worktree で誤リポジトリへ解決しない権威指定）。
echo "[pre-commit] 差分整合性チェック（cli.ts --changed）を実行します。"
if ! (cd "$REPO_ROOT" && bun run "$CLI" --root "$REPO_ROOT" --changed); then
  fail_with_guidance
fi

# --- Step 3（インデックス鮮度チェック）---
# docs/ または src/ の変更が含まれる場合に実行する。
stages_docs_or_src=false
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    docs/*|src/*) stages_docs_or_src=true; break ;;
  esac
done < <(staged_paths)

if [ "$stages_docs_or_src" = true ]; then
  echo "[pre-commit] インデックス鮮度チェック（check_autogen_freshness.ts）を実行します。"
  if ! bun run "$AUTOGEN_GATE" --root "$REPO_ROOT"; then
    fail_with_guidance
  fi
fi

echo "[pre-commit] すべての検証ゲートを通過しました。"
exit 0
