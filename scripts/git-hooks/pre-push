#!/usr/bin/env bash
# ADF-COVERS(implementation): REQ-122-009, REQ-122-015
# pre-push — 既存の正規決定論的チェッカーを呼ぶだけの薄いラッパー（agent-dev-flow 専用・配布物外）。
# フック側に独自のしきい値判定・ファイルサイズ計算・非同期キューの滞留監視ロジックは持たない。
# REPO_ROOT は git rev-parse --show-toplevel 起点（worktree 環境対応）。
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "[pre-push] Step 1/3: インデックス鮮度チェック（check_autogen_freshness.ts）を実行します。"
(cd "$REPO_ROOT" && bun run .opencode/skills/repo-agentdev-integrity/scripts/check_autogen_freshness.ts --root "$REPO_ROOT")

echo "[pre-push] Step 2/3: 全量整合性チェック（cli.ts）を実行します。"
(cd "$REPO_ROOT" && bun run .opencode/skills/repo-agentdev-integrity/scripts/cli.ts --root "$REPO_ROOT")

echo "[pre-push] Step 3/3: 検証エンジンのテストスイート（bun test・REQ-060 実行形態）を実行します。"
# git push はフックへ GIT_DIR・GIT_WORK_TREE・GIT_INDEX_FILE 等の環境変数をエクスポートする。
# テストスイートはネストした git リポジトリのフィクスチャを生成して git 操作を行うため、
# これらの変数が残っているとフィクスチャの操作が外側の実リポジトリへ横取りされる。
# Step 3 の実行時のみこれらを無効化する（Step 1・2 は実リポジトリ自身を検査するため無効化しない）。
(cd "$REPO_ROOT" && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_QUARANTINE_PATH -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_PREFIX bun test ./src/common/skills/repo-agentdev-integrity/scripts/)

echo "[pre-push] すべての検証を通過しました。"
