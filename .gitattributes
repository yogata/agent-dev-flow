# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Markdown files
*.md text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# JSON files
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Git hooks（Git-for-Windows bash で実行されるため LF 固定。CRLF 混入による実行エラー防止）
scripts/git-hooks/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
